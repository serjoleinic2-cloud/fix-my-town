config_version=5

[application]
config/name="Fix My Town"
config/icon="res://assets/icons/app_icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=540
window/size/viewport_height=1200
window/size/window_width_override=540
window/size/window_height_override=1200
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/subwindows/embed_subwindows=true
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.81, 0.88, 0.86, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true
